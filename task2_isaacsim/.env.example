# Environment for the Task 2 ROS 2 helper services (task2_isaacsim/docker-compose.yml).
# Copy to .env (auto-read by docker compose) to override defaults; copying is optional
# because docker-compose.yml already falls back to these same values.

# ros_joint_republisher: remap /bridge/* -> /isaac/* and calibrate the gripper.
REPUBLISHER_BRIDGE_PREFIX="/bridge"
REPUBLISHER_ISAAC_PREFIX="/isaac"
REPUBLISHER_GRIPPER_OPEN_POSITION="0.0"
REPUBLISHER_GRIPPER_CLOSED_POSITION="0.8"
REPUBLISHER_GRIPPER_INVERT="true"

# teleop_adapters: which sim-side adapters to launch ("keyboard", "gello", or both).
TELEOP_ADAPTERS="keyboard gello"

# Controller mode used by scripts/run_isaacsim_teleop.sh (none|position).
CONTROLLER_MODE="position"

# eval_recording: organizer-side evaluation audit recorder
# (services/eval_recording/, launched via scripts/run_eval_recorder.sh).
# EVAL_NAME names the session subdir eval_raw_out/<name>/; EVAL_RAW_OUT is
# the output root as a container path relative to /repo/task2_isaacsim.
EVAL_NAME="dev"
EVAL_RAW_OUT="services/eval_recording/eval_raw_out"
# EVAL_RECORDER_CONFIG="services/eval_recording/eval_recording.yaml"
# EVAL_RECORDER_ARGS=""
# Official evaluator artifact root (same variable as scripts/evaluation/task2
# and docker/.env.base); <root>/eval-task2 is mounted read-only at /eval_out.
# ISAAC_DOCKER_ROOT="/home/<user>/docker/ebim-challenge"
# Session provenance (run_eval_recorder.sh): optional checkout to stamp as
# eval_target_head, and the container/image names it `docker inspect`s.
# EVAL_TARGET_DIR=""
# ISAAC_SIM_5_CONTAINER="isaac-sim-5-1-0-workshop"
# EVAL_SERVICE_CONTAINER="eval_task2"
